# Local reproducibility manifest: review before intentionally committing.
source-revisions.json

# Xcode-compatible locally generated frameworks and intermediates.
.build/

# Generated on the working Mac; review before explicitly committing.
source-lock.json

# Local review evidence and automated report output
release-readiness.json
