#!/usr/bin/env bash
# .githooks/pre-push — lightweight advisory before any push reaches origin.
#
# Never blocks a push. GitHub CI (build-check.yml) is the build gate and builds every pull request, so a
# local build here would be redundant (and concurrent xcodebuild runs caused "database is locked" failures).
# This only prints a reminder of how to check the change locally.
#
# Bypass: git push --no-verify  or  SKIP_VERIFY=1 git push
#
# Setup (once per clone):  ./Scripts/install-hooks.sh

if [ "${SKIP_VERIFY:-0}" = "1" ]; then
  exit 0
fi

echo "[pre-push] CI builds this on the pull request. To check it locally first: ./Scripts/prove.sh"
exit 0
