@@ -1786,6 +1786,31 @@ static bool ConvertShaderNotNeeded(ShaderConvert shader)
 
 static bool s_capture_next = false;
 
+#ifdef OE_METAL_OUTPUT
+#include <atomic>
+
+// OpenEmu owns two output textures. When they are set, the final "present" pass renders
+// into one of them instead of into a window drawable, alternating each frame. OpenEmu
+// shows the one that GSDeviceMTLReadyOutputIndex() names, which is the newest frame the GPU
+// has finished, so the CPU never waits for the GPU.
+static MRCOwned<id<MTLTexture>> s_oe_output_textures[2];
+static std::atomic<int> s_oe_ready_index{0};
+static int s_oe_render_index = 0;
+
+void GSDeviceMTLSetOutputTextures(void* texture0, void* texture1)
+{
+	s_oe_output_textures[0] = MRCRetain((__bridge id<MTLTexture>)texture0);
+	s_oe_output_textures[1] = MRCRetain((__bridge id<MTLTexture>)texture1);
+	s_oe_ready_index = 0;
+	s_oe_render_index = 0;
+}
+
+int GSDeviceMTLReadyOutputIndex()
+{
+	return s_oe_ready_index.load(std::memory_order_acquire);
+}
+#endif
+
 GSDevice::PresentResult GSDeviceMTL::DoBeginPresent(bool frame_skip)
 { @autoreleasepool {
