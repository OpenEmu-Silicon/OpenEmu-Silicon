+	{
+		[m_pass_desc colorAttachments][0].texture = s_oe_output_textures[s_oe_render_index];
+		id<MTLRenderCommandEncoder> oe_enc = [buf renderCommandEncoderWithDescriptor:m_pass_desc];
+		[oe_enc setLabel:@"Present"];
+		m_current_render.encoder = MRCRetain(oe_enc);
+		return PresentResult::OK;
+	}
+#endif
 	if (!m_current_drawable)
 	{
 		[buf pushDebugGroup:@"Present Skipped"];
